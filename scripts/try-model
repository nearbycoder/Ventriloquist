#!/usr/bin/env python3
"""Runs one model from a terminal, through the same worker the app uses.

    scripts/try-model kokoro "Hello there."
    scripts/try-model qwen3-clone "Hello." --ref voice.wav
    scripts/try-model chatterbox-vc --source speech.wav --ref voice.wav
    scripts/try-model voicechat --source question.wav
    scripts/try-model kitten "we won the grant i can hardly believe it" --enhance
    scripts/try-model drama3 "two friends argue about who left the door open" --scene short

Prints the worker's events and where the audio went. `--twice` runs it again once the model
is loaded, which is the number that matters for speed.
"""

import argparse
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CATALOG = json.loads((ROOT / "sidecar" / "catalog.json").read_text())
MODELS = {m["id"]: m for m in CATALOG["models"]}


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("model", choices=sorted(MODELS))
    parser.add_argument("text", nargs="?", default="The puppet never knew whose voice it was.")
    parser.add_argument("--voice")
    parser.add_argument("--ref", help="voice sample to imitate")
    parser.add_argument("--ref-text", default="")
    parser.add_argument("--instruct", default="")
    parser.add_argument("--source", help="speech to convert or answer")
    parser.add_argument("--out", help="where to write the wav")
    parser.add_argument("--twice", action="store_true")
    parser.add_argument("--preprompt", default="", help="standing instructions for --enhance")
    parser.add_argument("--scene", choices=["short", "medium", "long"], help="treat the text as a scene to write dialogue for, and stop there")
    parser.add_argument("--enhance", action="store_true", help="rewrite the text for this model with the prompt enhancer, and stop there")
    parser.add_argument("--quiet", action="store_true", help="hide what the libraries print")
    # The text may come before or after the options.
    args = parser.parse_intermixed_args()

    target = args.model
    if args.scene:
        args.enhance = True
    if args.enhance:
        args.model = "enhancer"
    model = MODELS[args.model]
    data = Path(os.environ.get("VENTRILOQUIST_HOME") or Path.home() / "Library/Application Support/Ventriloquist")
    python = data / "envs" / model["env"] / "bin" / "python"
    if not python.is_file():
        sys.exit(f"{model['name']} isn't installed. Run: scripts/setup-models {args.model}")
    out = args.out or str(Path(tempfile.gettempdir()) / f"ventriloquist-{args.model}.wav")
    env = {**os.environ, "PYTHONUNBUFFERED": "1", "TOKENIZERS_PARALLELISM": "false", "PYTORCH_ENABLE_MPS_FALLBACK": "1"}
    env["PATH"] = f"/opt/homebrew/bin:{env.get('PATH', '')}"
    worker = subprocess.Popen(
        [str(python), "-u", str(ROOT / "sidecar" / "worker.py")],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL if args.quiet else None,
        text=True,
        env=env,
    )
    ok = True
    for run in range(2 if args.twice else 1):
        request = {
            "id": run + 1,
            "model": args.model,
            "text": args.text,
            "voice": args.voice or model.get("voice_default"),
            "ref_audio": os.path.abspath(args.ref) if args.ref else None,
            "ref_text": args.ref_text,
            "instruct": args.instruct,
            "source_audio": os.path.abspath(args.source) if args.source else None,
            "out": out,
        }
        if args.scene:
            request = {"op": "scene", "id": run + 1, "model": "enhancer", "target": target, "text": args.text, "length": args.scene, "preprompt": args.preprompt}
        elif args.enhance:
            request = {"op": "enhance", "id": run + 1, "model": "enhancer", "target": target, "text": args.text, "instruct": args.instruct, "preprompt": args.preprompt}
        worker.stdin.write(json.dumps(request) + "\n")
        worker.stdin.flush()
        for line in worker.stdout:
            event = json.loads(line)
            if event.get("event") == "ready":
                continue
            print(json.dumps(event), flush=True)
            if event.get("event") in ("done", "error"):
                ok = ok and event["event"] == "done"
                break
        else:
            sys.exit("The worker quit before it answered.")
    worker.stdin.close()
    worker.wait()
    if ok and not args.enhance:
        print(out)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
